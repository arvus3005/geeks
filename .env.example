# ── Pinecone credentials (NEVER commit real values — env-var only at runtime) ──
PINECONE_API_KEY=

# ── Pinecone index configuration ──────────────────────────────────────────────
PINECONE_INDEX=msmarco-xi
PINECONE_NAMESPACE=pilot_v1

# Pinecone infrastructure (Starter: AWS us-east-1 only)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Pinecone plan (controls budget enforcement; "starter" blocks full-corpus)
PINECONE_PLAN=starter

# ── Pinecone embedding / retrieval ─────────────────────────────────────────────
PINECONE_EMBED_MODEL=multilingual-e5-large
PINECONE_TEXT_FIELD=chunk_text
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_CANDIDATE_K=8
PINECONE_RERANK_TOP_N=3

# ── Ingestion confirmation (both required for real writes; NEVER bypass) ───────
# CONFIRM_PINECONE_CREATE=1           # required to create a real index
# CONFIRM_PINECONE_WRITE=1            # required for real upserts
# CONFIRM_FULL_INGEST=YES_I_APPROVE_FULL_CORPUS   # required for full mode (+ --confirm-full-ingest)

# ── STT (Sarvam — not yet integrated) ─────────────────────────────────────────
SARVAM_API_KEY=

# ── Optional Hugging Face token for gated datasets ────────────────────────────
HF_TOKEN=

# ── Application ───────────────────────────────────────────────────────────────
CORPUS_MODE=pilot
WHISPER_ENABLED=false
